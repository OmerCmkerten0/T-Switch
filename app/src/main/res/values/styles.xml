<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Soft rounded card container -->
    <style name="SoftCard">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Soft rounded button (18dp radius) -->
    <style name="SoftButton">
        <item name="android:background">@drawable/soft_btn_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Soft pill button/chip (999dp radius) -->
    <style name="SoftPillButton">
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Soft circle/oval button for keypad or in-call actions -->
    <style name="SoftCircleButton">
        <item name="android:background">@drawable/circle_btn_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
